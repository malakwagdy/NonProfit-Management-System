<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.nonprofitmanagementsystem.controller.AssistanceController">
    <Label text="Assistance" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
    <Label fx:id="eligibilityLabel"/>
    <Label text="Requests are reviewed by an administrator before any assistance is delivered."/>

    <Label text="Available resources" style="-fx-font-weight: bold;"/>
    <TableView fx:id="resourcesTable" prefHeight="160">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="resourceNameColumn" text="Resource" prefWidth="170"/>
            <TableColumn fx:id="resourceCategoryColumn" text="Category" prefWidth="110"/>
            <TableColumn fx:id="resourceTypeColumn" text="Type" prefWidth="80"/>
            <TableColumn fx:id="resourceAvailableColumn" text="Available" prefWidth="110"/>
        </columns>
    </TableView>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Quantity"/>
        <TextField fx:id="quantityField" text="1" prefWidth="60"/>
        <Button text="Request selected resource" onAction="#onRequest"/>
    </HBox>
    <Label fx:id="messageLabel" wrapText="true"/>

    <Label text="My requests" style="-fx-font-weight: bold;"/>
    <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="You have not requested any assistance yet."/>
        </placeholder>
        <columns>
            <TableColumn fx:id="requestIdColumn" text="ID" prefWidth="45"/>
            <TableColumn fx:id="requestResourceColumn" text="Resource" prefWidth="170"/>
            <TableColumn fx:id="requestQuantityColumn" text="Quantity" prefWidth="70"/>
            <TableColumn fx:id="requestDateColumn" text="Requested on" prefWidth="130"/>
            <TableColumn fx:id="requestStatusColumn" text="Status" prefWidth="100"/>
            <TableColumn fx:id="requestReasonColumn" text="Decision note" prefWidth="180"/>
        </columns>
    </TableView>
</VBox>
