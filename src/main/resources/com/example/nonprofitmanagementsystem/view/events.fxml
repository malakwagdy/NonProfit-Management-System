<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.nonprofitmanagementsystem.controller.EventsController">
    <Label text="Upcoming Events" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="nameColumn" text="Event" prefWidth="170"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="110"/>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="130"/>
            <TableColumn fx:id="locationColumn" text="Location" prefWidth="140"/>
            <TableColumn fx:id="spotsColumn" text="Registered" prefWidth="75"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="80"/>
            <TableColumn fx:id="myStatusColumn" text="Me" prefWidth="150"/>
        </columns>
    </TableView>

    <Label fx:id="descriptionLabel" wrapText="true"/>

    <HBox spacing="10">
        <Button text="Register" onAction="#onRegister"/>
        <Button text="Cancel registration" onAction="#onCancelRegistration"/>
        <Button fx:id="followButton" text="Follow fundraiser" onAction="#onFollow"/>
        <Button fx:id="unfollowButton" text="Unfollow" onAction="#onUnfollow"/>
    </HBox>
    <Label fx:id="messageLabel" wrapText="true"/>
</VBox>
