<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.nonprofitmanagementsystem.controller.MainController">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-border-color: lightgray; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>
            <Label fx:id="welcomeLabel" style="-fx-font-size: 15; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Log out" onAction="#onLogout"/>
        </HBox>
    </top>

    <left>
        <VBox fx:id="menu" spacing="8" prefWidth="170" style="-fx-border-color: lightgray; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets top="15" right="10" bottom="15" left="10"/>
            </padding>
        </VBox>
    </left>
</BorderPane>
